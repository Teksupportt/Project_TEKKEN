<?xml version="1.0"?>
<robot name="simple_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- robot_name: sets the topic/TF namespace so two instances in the
       same Gazebo world don't collide (each spawn_robot.launch.py call
       passes a different value, e.g. robot1 / robot2). -->
  <xacro:arg name="robot_name" default="robot1"/>
  <xacro:property name="ns" value="$(arg robot_name)"/>

  <!-- Chassis -->
  <xacro:property name="chassis_length" value="0.30"/>
  <xacro:property name="chassis_width" value="0.20"/>
  <xacro:property name="chassis_height" value="0.10"/>
  <xacro:property name="chassis_mass" value="3.0"/>

  <!-- Wheels -->
  <xacro:property name="wheel_radius" value="0.05"/>
  <xacro:property name="wheel_width" value="0.03"/>
  <xacro:property name="wheel_mass" value="0.3"/>
  <xacro:property name="wheel_separation" value="0.24"/>
  <xacro:property name="wheel_x_offset" value="0.0"/>

  <link name="${ns}/base_link">
    <visual>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <material name="chassis_color"><color rgba="0.2 0.4 0.8 1.0"/></material>
    </visual>
    <collision>
      <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </collision>
    <inertial>
      <mass value="${chassis_mass}"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.08" iyz="0.0" izz="0.10"/>
    </inertial>
  </link>

  <!-- Wheel macro -->
  <xacro:macro name="wheel" params="prefix y_offset">
    <link name="${ns}/${prefix}_wheel">
      <visual>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <material name="wheel_color"><color rgba="0.1 0.1 0.1 1.0"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
      </inertial>
    </link>

    <joint name="${ns}/${prefix}_wheel_joint" type="continuous">
      <parent link="${ns}/base_link"/>
      <child link="${ns}/${prefix}_wheel"/>
      <origin xyz="${wheel_x_offset} ${y_offset} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" y_offset="${wheel_separation/2}"/>
  <xacro:wheel prefix="right" y_offset="${-wheel_separation/2}"/>

  <!-- Caster (passive, back of chassis) -->
  <link name="${ns}/caster_wheel">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="caster_color"><color rgba="0.3 0.3 0.3 1.0"/></material>
    </visual>
    <collision>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0001" ixy="0.0" ixz="0.0" iyy="0.0001" iyz="0.0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="${ns}/caster_joint" type="fixed">
    <parent link="${ns}/base_link"/>
    <child link="${ns}/caster_wheel"/>
    <origin xyz="-0.12 0 -0.025" rpy="0 0 0"/>
  </joint>

  <!-- 2D Lidar -->
  <link name="${ns}/laser_link">
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="laser_color"><color rgba="0.8 0.1 0.1 1.0"/></material>
    </visual>
    <collision>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00005" ixy="0.0" ixz="0.0" iyy="0.00005" iyz="0.0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="${ns}/laser_joint" type="fixed">
    <parent link="${ns}/base_link"/>
    <child link="${ns}/laser_link"/>
    <origin xyz="0.1 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo: differential drive plugin.
       Subscribes to cmd_vel_out (not the usual cmd_vel) so it takes
       heading_controller's arbitrated output directly, with no extra
       remap node needed. -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>${ns}</namespace>
        <remapping>cmd_vel:=cmd_vel_out</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <left_joint>${ns}/left_wheel_joint</left_joint>
      <right_joint>${ns}/right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${wheel_radius*2}</wheel_diameter>
      <max_wheel_torque>10</max_wheel_torque>
      <max_wheel_acceleration>5.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_frame>${ns}/odom</odometry_frame>
      <robot_base_frame>${ns}/base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- Gazebo: 2D lidar sensor. Publishes to "scan" under the robot's
       namespace, matching what lidar_2d_tracker subscribes to once
       heading/perception nodes are launched with the same robot_name. -->
  <gazebo reference="${ns}/laser_link">
    <sensor type="ray" name="lidar_2d">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="lidar_2d_plugin" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <namespace>${ns}</namespace>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>${ns}/laser_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="${ns}/base_link">
    <material>Gazebo/Blue</material>
  </gazebo>

</robot>
