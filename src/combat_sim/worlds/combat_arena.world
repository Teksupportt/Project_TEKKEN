<?xml version="1.0"?>
<sdf version="1.6">
  <world name="combat_arena">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 6x6m arena boundary so robots (and lidar returns) stay bounded -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -3 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>3 0 0.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-3 0 0.25 0 0 1.5708</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>6 0.1 0.5</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>6 0.1 0.5</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
